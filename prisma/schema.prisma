// ============================ BACKOFFICE ============================

/// Welches Produkt eine Akte traegt. `vertrieb` ist der Bestand: ein Fall mit
/// Leadphase, Quelle und Provision. `backoffice` ist die Finanzierungsakte
/// eines externen Auftrags - sie ist kein Lead und erscheint in keiner
/// Vertriebsliste. Jede org-weite Fallabfrage des Vertriebs filtert darauf
/// (src/lib/cases/aktenart.ts).
enum AkteArt {
  vertrieb
  backoffice
}

/// Stellung eines Nutzers im Backoffice seiner Organisation. Bewusst ein
/// eigenes Feld neben UserRole: Die Vertriebsrolle sagt nichts darueber,
/// ob jemand Auftraege aufbereiten oder freigeben darf.
enum BackofficeRolle {
  manager
  bearbeiter
  pruefer
}

enum BackofficeStatus {
  neu_eingegangen
  auftrag_pruefen
  wartet_auf_unterlagen
  in_aufbereitung
  rueckfrage_auftraggeber
  qualitaetskontrolle
  einreichungsfertig
  uebergeben
  abgeschlossen
  nachbearbeitung
  abgelehnt
  storniert
}

enum BackofficePrioritaet {
  niedrig
  normal
  hoch
  dringend
}

enum BackofficeRueckfrageStatus {
  entwurf
  offen
  beantwortet
  erledigt
}

/// Wie ein Auftraggeber abgerechnet wird. `intern` ist die eigene
/// Organisation bei einer Uebergabe aus dem Vertrieb - dort gibt es kein
/// Kontingent.
enum BackofficeAbrechnungsmodell {
  testfall
  abo
  partner
  intern
}

enum BackofficeAbrechnungsstatus {
  offen
  abgerechnet
  nicht_abrechenbar
}

enum BackofficeKontingentArt {
  verbrauch
  zusatzfall
  korrektur
}

// ============================ MANDANT / NUTZER ============================

model Organization {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  street             String?
  zip                String?
  city               String?
  website            String?
  // Telefon des Hauses. Steht auf dem Finanzierungszertifikat unter dem Namen
  // des Beraters – dort erwartet der Makler eine Nummer, unter der er anruft.
  phone              String?
  /// Pflichtangaben des Vermittlers für den Fuß erzeugter Papiere: Rechtsform,
  /// zuständige IHK, Registernummer nach § 34i GewO.
  ///
  /// Bewusst EIN mehrzeiliges Freitextfeld und keine fünf Einzelfelder: Was
  /// dort stehen muss, weiß der Vermittler; eine geratene Feldaufteilung
  /// zwingt ihn nur, seine Angaben hineinzuquetschen. Wird wörtlich und
  /// unverändert übernommen.
  rechtlicherHinweis String?
  /// Speicherschlüssel des hochgeladenen Unterschriftsbilds (PNG/JPG).
  /// Erscheint auf dem Finanzierungszertifikat über dem Namen.
  unterschriftKey    String?
  // Datenschutz: Aufbewahrungsfrist (0 = bis manuelle Loeschung)
  retentionDays      Int      @default(0)
  isWhiteLabel       Boolean  @default(false)
  /// Vorgabe fuer die Bearbeitungsfrist neuer Backoffice-Auftraege in
  /// Werktagen, wenn der Auftraggeber keine eigene nennt.
  backofficeSlaTage  Int      @default(3)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users                  User[]
  customers              Customer[]
  cases                  Case[]
  checklistTemplates     ChecklistTemplate[]
  platformConnections    PlatformConnection[]
  messageTemplates       MessageTemplate[]
  subscription           Subscription?
  featureFlags           FeatureFlag[]
  whiteLabelSettings     WhiteLabelSettings?
  bankRequirements       BankRequirement[]
  auditLogs              AuditLog[]
  leadSyncStates         LeadSyncState[]
  machbarkeitsAnnahmen   MachbarkeitsAnnahmen?
  leadformulare          Leadformular[]
  /// Auftraggeber, die DIESE Organisation als Backoffice betreut.
  backofficeAuftraggeber BackofficeAuftraggeber[] @relation("BackofficeMandant")
  /// Backoffice-Partner, bei denen DIESE Organisation Auftraggeber ist (Portal).
  auftraggeberZugaenge   BackofficeAuftraggeber[] @relation("AuftraggeberOrganisation")
  backofficeAuftraege    BackofficeAuftrag[]

  @@map("organizations")
}

model User {
  id                  String           @id @default(cuid())
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email               String           @unique
  name                String
  // Passwort-Hash – niemals Klartext. Auth via Provider moeglich.
  passwordHash        String?
  role                UserRole         @default(vermittler)
  active              Boolean          @default(true)
  // Plattform-Ebene: darf Registrierungsantraege freigeben. Bewusst KEIN Wert im
  // UserRole-Enum – die Rollen beschreiben die Stellung innerhalb einer
  // Organisation, nicht ueber ihnen.
  platformAdmin       Boolean          @default(false)
  /// Stellung im Backoffice der eigenen Organisation. null = kein Zugang zum
  /// Backoffice-Produkt, unabhaengig von der Vertriebsrolle.
  backofficeRolle     BackofficeRolle?
  invitedAt           DateTime?
  // Sperre gegen wiederholte "Adresse bereits vergeben"-Mails. Liegt am User,
  // weil es zu direkt angelegten Konten keinen SignupRequest gibt.
  letzteHinweisMailAm DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  casesAsBroker     Case[]            @relation("CaseBroker")
  auditLogs         AuditLog[]
  caseNotes         CaseNote[]
  authTokens        AuthToken[]
  erledigteAufgaben AufgabeErledigt[]

  backofficeBearbeitet BackofficeAuftrag[]             @relation("BackofficeBearbeiter")
  backofficeGeprueft   BackofficeAuftrag[]             @relation("BackofficePruefer")
  backofficeErstellt   BackofficeAuftrag[]             @relation("BackofficeErsteller")
  backofficeEreignisse BackofficeAuftragEreignis[]
  auftraggeberKontakte BackofficeAuftraggeberKontakt[]

  @@index([organizationId])
  @@map("users")
}

// "roles" als konfigurierbare Rechte-Definition (RBAC-Basis, MVP: feste Rollen)
model Role {
  id             String   @id @default(cuid())
  organizationId String?
  key            String
  label          String
  permissions    Json // string[] der erlaubten Aktionen
  createdAt      DateTime @default(now())

  @@unique([organizationId, key])
  @@map("roles")
}

// ============================ KUNDE / ANTRAGSTELLER ============================

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String?
  phone          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  cases Case[]

  @@index([organizationId])
  @@map("customers")
}

model Applicant {
  id                   String         @id @default(cuid())
  caseId               String
  case                 Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  position             Int // 1 = Antragsteller 1, 2 = Antragsteller 2 ...
  anrede               String? // "herr" | "frau" – aus der Selbstauskunft, für Anschreiben
  vorname              String?
  nachname             String?
  geburtsdatum         DateTime?
  geburtsort           String?
  staatsangehoerigkeit String?
  familienstand        MaritalStatus?
  anzahlKinder         Int?
  street               String?
  zip                  String?
  city                 String?
  email                String?
  phone                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  employment     EmploymentRecord[]
  selfEmployment SelfEmploymentRecord[]
  income         IncomeRecord[]
  documents      Document[]

  @@index([caseId])
  @@map("applicants")
}

// ============================ FALL ============================

model Case {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caseNumber     String
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  brokerId       String?
  broker         User?        @relation("CaseBroker", fields: [brokerId], references: [id], onDelete: SetNull)

  /// Vertriebsfall oder Backoffice-Akte. Siehe enum AkteArt.
  akteArt AkteArt @default(vertrieb)

  status              CaseStatus  @default(neu)
  // Status vor dem Archivieren – beim Entarchivieren wiederhergestellt, damit ein
  // abgeschlossener Fall nicht als "Unterlagen fehlen" zurückkommt.
  statusBeforeArchive CaseStatus?

  // Vertriebsphase – unabhängig vom Bearbeitungsstatus. "Verloren" ist KEIN
  // Phasenwert: verlorenAm gesetzt heißt verloren, die zuletzt erreichte Phase
  // bleibt erhalten (damit auswertbar ist, WO verloren wird).
  leadPhase     LeadPhase @default(neu)
  leadPhaseSeit DateTime  @default(now())
  verlorenAm    DateTime?
  verlorenGrund String?

  // Herkunft des Falls. Der Rohwert bleibt erhalten, damit nachvollziehbar
  // ist, woraus die Zuordnung entstand – kommt morgen ein neuer Wert, steht
  // hier "unbekannt", aber das Original ist noch da.
  quelle                LeadSource      @default(unbekannt)
  quelleDetail          String?
  // Dreiwertig: null heißt "keine Angabe" und ist NICHT "nein".
  einwilligungKontakt   Boolean?
  einwilligungMarketing Boolean?
  financingType         FinancingType?
  primaryEmploymentType EmploymentType?
  kapitalanlage         Boolean         @default(false)
  selbstnutzung         Boolean         @default(true)
  vermieteterAnteil     Int?

  // Ziel-/einreichende Bank (steuert bankindividuelle Anforderungen & Aufbereitung)
  bankName      String?
  // Manuelle Wiedervorlage (Vermittler legt einen Termin fest)
  wiedervorlage DateTime?

  // Erstgespräch als geführt abgehakt. Nicht "alle Angaben da", sondern "ich
  // habe das Gespräch geführt": Die Reifeleiste zählt ~35 Angaben, von denen
  // etliche zu Recht leer bleiben (keine weiteren Einkünfte, kein
  // Konditionswunsch). Ohne diesen Haken bliebe die Fallreise für immer auf
  // "Erstgespräch führen" stehen und verdeckte Machbarkeit, Unterlagen und
  // Einreichung – die Leiter zeigt bauartbedingt nur einen Schritt.
  // Datum statt Boolean, damit nachvollziehbar bleibt, WANN abgehakt wurde.
  erstgespraechGefuehrtAm DateTime?

  // Abschlussdaten (Provisions-/Pipeline-Tracking) – erst nach Zusage relevant
  abschlussBank   String?
  darlehensbetrag Float?
  sollzinsProzent Float?
  courtageProzent Float?
  abschlussdatum  DateTime?

  // Plattform-IDs
  finlinkId         String?
  europaceVorgangId String?
  ehypHomeId        String?

  // Einreichungsstatus 0..100 (berechnet)
  readinessScore Int @default(0)

  // Datenschutz / Aufbewahrung pro Vorgang
  retentionDays Int?
  deleteAfter   DateTime?

  // Wann der Erstkontakt vorbereitet wurde (Links + Nachrichtenentwurf).
  // Verhindert, dass ein zweiter Lauf einen zweiten Entwurf erzeugt.
  erstkontaktVorbereitetAm DateTime?
  // Genau der Entwurf, der zu diesem Erstkontakt gehoert. Ohne diesen Bezug
  // musste die Fallseite den aeltesten "erstnachforderung"-Entwurf raten - ein
  // ganz normaler, vom Vermittler erzeugbarer Nachrichtentyp. Ein alter, nie
  // versendeter Nachforderungsentwurf liess die Karte dann "Entwurf liegt
  // bereit" behaupten, obwohl nie ein Erstkontakt vorbereitet wurde.
  // Bewusst ohne Fremdschluessel-Relation: die Nachricht ist nur ein Verweis,
  // kein Besitz - wird sie geloescht, gilt der Erstkontakt als nicht vorbereitet.
  erstkontaktMessageId     String?

  /// Lauf der Einzelseiten-Erkennung. Eigener Status, damit "nicht geprueft"
  /// und "nichts gefunden" unterscheidbar bleiben - und als Sperre, damit
  /// nicht zwei gleichzeitig fertige Dokumente denselben Lauf starten.
  buendelStatus   ProcessingStatus  @default(ausstehend)
  /// Beginn des laufenden bzw. Ende des letzten Laufs. Ohne diesen Zeitstempel
  /// laesst sich eine haengende Sperre nicht von einem echten Lauf
  /// unterscheiden.
  buendelStatusAm DateTime?
  buendel         DocumentBuendel[]

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicants          Applicant[]
  sources             CaseSource[]
  property            Property?
  financingRequest    FinancingRequest?
  liabilities         Liability[]
  assets              Asset[]
  documents           Document[]
  caseChecklistItems  CaseChecklistItem[]
  missingRequests     MissingDocumentRequest[]
  generatedMessages   GeneratedMessage[]
  uploadLinks         UploadLink[]
  selfDisclosureLinks SelfDisclosureLink[]
  selfDisclosures     SelfDisclosure[]
  customerForm        CustomerForm?
  platformMappings    PlatformMapping[]
  platformSyncLogs    PlatformSyncLog[]
  exportJobs          ExportJob[]
  aiJobs              AiJob[]
  plausibilityChecks  PlausibilityCheck[]
  wohnflaechen        WohnflaechenBerechnung[]
  caseNotes           CaseNote[]
  deadlines           CaseDeadline[]
  documentReferences  DocumentReference[]
  findings            CaseFinding[]
  anforderungsAbrufe  BankAnforderungsAbruf[]
  erledigteAufgaben   AufgabeErledigt[]
  kreditpruefung      Kreditpruefung?
  backofficeAuftraege BackofficeAuftrag[]

  @@unique([organizationId, caseNumber])
  @@index([organizationId, status])
  @@index([organizationId, akteArt])
  // Die Dublettenprüfung des Lead-Abgleichs läuft je Lead über dieses Feld.
  @@index([finlinkId])
  @@map("cases")
}

// Von Hand abgehakte Aufgabe der Heute-Liste.
//
// NUR fuer Schritte, die kein eigenes Tatsachenfeld haben. Wo BaufiDesk die
// Tatsache selbst festhalten kann, trägt der Haken sie dort ein statt hier:
// das Erstgespraech in `erstgespraechGefuehrtAm`, die Wiedervorlage in ihrem
// eigenen Datum. Sonst wuesste nur die Heute-Liste Bescheid und Fallakte,
// Kanban und Prioritaetsleiter behaupteten weiter das Gegenteil – genau der
// Fehler, der bei "Kredit zugesagt" an vier Stellen gleichzeitig auftrat.
//
// Der Vermerk gilt fuer GENAU EINEN Schritt-Schluessel. Bewegt sich der Fall
// weiter und die Leiter nennt einen anderen Schritt, ist das eine neue
// Aufgabe – der alte Vermerk greift dann nicht mehr und muss auch nicht
// aufgeraeumt werden.
model AufgabeErledigt {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  // Ein `NextStep["key"]`, bewusst als String: Ein neuer Schritt in
  // next-step.ts soll keine Migration gegen die Produktionsdatenbank
  // erzwingen. Der Preis ist, dass die Datenbank Tippfehler nicht abfaengt –
  // dagegen steht ein Vertragstest ueber alle Schluessel.
  schritt    String
  erledigtAm DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Zweimal abhaken darf keinen zweiten Vermerk erzeugen: Das Rueckgaengig
  // machen loescht sonst nur einen von beiden und die Aufgabe bliebe weg.
  @@unique([caseId, schritt])
  @@map("aufgaben_erledigt")
}

// Kontakthistorie / Notizen am Fall (Telefonnotizen, Wiedervorlagen, freie Notizen).
model CaseNote {
  id        String           @id @default(cuid())
  caseId    String
  case      Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  kind      CaseNoteKind     @default(notiz)
  body      String
  ergebnis  KontaktErgebnis?
  createdAt DateTime         @default(now())

  @@index([caseId, createdAt])
  @@map("case_notes")
}

// Fristen am Fall (Zinsbindung Angebot, Notartermin, Nachreichfrist der Bank …).
model CaseDeadline {
  id        String       @id @default(cuid())
  caseId    String
  case      Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind      DeadlineKind @default(sonstige)
  title     String
  dueDate   DateTime
  done      Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([caseId, dueDate])
  @@map("case_deadlines")
}

model CaseSource {
  id         String         @id @default(cuid())
  caseId     String
  case       Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type       CaseSourceType
  externalId String? // z.B. FinLink-/Europace-ID
  payload    Json? // Rohdaten der Quelle (ohne sensible Logs)
  createdAt  DateTime       @default(now())

  @@index([caseId])
  @@map("case_sources")
}

// Gespeichertes Kunden-Erstformular
model CustomerForm {
  id        String   @id @default(cuid())
  caseId    String   @unique
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  data      Json // validierte Formularfelder (siehe Zod customerFormSchema)
  submitted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_forms")
}

// ============================ OBJEKT / FINANZIERUNG ============================

model Property {
  id                       String        @id @default(cuid())
  caseId                   String        @unique
  case                     Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  objektart                PropertyType?
  street                   String?
  zip                      String?
  city                     String?
  wohnflaeche              Float?
  nutzflaeche              Float?
  grundstuecksflaeche      Float?
  baujahr                  Int?
  zustand                  String?
  anzahlZimmer             Float?
  anzahlWohneinheiten      Int?
  heizungsart              String?
  energieausweis           String?
  stellplaetze             Int?
  hausgeldMonatlich        Float?
  mieteinnahmenMonatlich   Float?
  nutzung                  UsageType?
  vermieteterAnteilProzent Int?
  /// Geschaetzter Wert der Immobilie. Nur erfragt, wo es keinen Kaufpreis gibt
  /// (Anschlussfinanzierung, Kapitalbeschaffung, Modernisierung) - dort ist er
  /// der Massstab fuer den Beleihungsauslauf, sonst der Kaufpreis.
  objektwert               Float?
  /// Restschuld eines auf der Immobilie laufenden Darlehens, das BESTEHEN
  /// BLEIBT. Verbraucht Beleihungsraum, wird aber nicht mitfinanziert. Bei der
  /// Anschlussfinanzierung gehoert die Restschuld nicht hierher, sondern in
  /// FinancingRequest.darlehenswunsch - dort wird sie abgeloest.
  bestehendeGrundschuld    Float?
  /// Manuell bestaetigtes Bundesland, falls die PLZ mehrdeutig ist.
  bundesland               String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@map("properties")
}

model FinancingRequest {
  id                            String   @id @default(cuid())
  caseId                        String   @unique
  case                          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kaufpreis                     Float?
  baukosten                     Float?
  modernisierungskosten         Float?
  nebenkosten                   Float?
  maklerprovisionProzent        Float?
  eigenkapital                  Float?
  darlehenswunsch               Float?
  /// Manuell gesetzter Grunderwerbsteuersatz, falls die Ableitung aus PLZ und
  /// Ort danebenliegt. Sichtbar im Machbarkeits-Ergebnis.
  grunderwerbsteuerProzent      Float?
  /// Gewuenschte Zinsbindung in Jahren. Freie Zahl, keine Auswahlliste:
  /// 5/10/15/20/30 sind ueblich, aber nicht die einzigen Werte.
  zinsbindungJahre              Int?
  /// Gewuenschte jaehrliche Sondertilgung in Prozent des Darlehens. 5 % ist
  /// marktueblich. null = nicht gefragt, 0 = ausdruecklich keine gewuenscht.
  /// Prozent statt ja/nein, weil Europace (annuitaetendetails.
  /// sondertilgungJaehrlich) einen Satz erwartet - aus einem "ja" muesste
  /// BaufiDesk sonst eine Zahl erfinden, die der Vermittler nie gesagt hat.
  sondertilgungProzentJaehrlich Float?
  /// Monatliche Wunschrate des Kunden. Nebenbedingung fuer den
  /// Machbarkeits-Solver: Er rechnet sonst nur gegen die TRAGBARE Rate.
  wunschrateMonatlich           Float?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@map("financing_requests")
}

/**
 * Was bei der Bank tatsaechlich zur Kreditpruefung eingereicht wurde.
 * Bewusst NICHT in FinancingRequest: dort stehen die WUENSCHE des Kunden
 * (Darlehenswunsch, Wunschrate, gewuenschte Zinsbindung). Hier stehen die
 * Konditionen des eingereichten Antrags - zwei verschiedene Wahrheiten, die
 * sich unterscheiden duerfen und muessen. Ein Feld mit zwei Rollen ist in
 * diesem Projekt schon einmal teuer geworden.
 * Ebenso getrennt von den Abschlussdaten am Case (abschlussBank,
 * darlehensbetrag, sollzinsProzent): Die gelten erst nach der Zusage und
 * koennen von der Einreichung abweichen - genau diese Abweichung ist die
 * interessante Zahl.
 * Quelle haelt fest, woher die Angaben stammen. Heute traegt der Vermittler
 * sie ein ("manuell"); sobald ein Plattformzugang das hergibt (Europace), holt
 * sie ein Abruf und ueberschreibt NUR, was von dort kam.
 */
model Kreditpruefung {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /// Bank, bei der eingereicht wurde. Freitext: der Bankenkatalog kennt 664
  /// Haeuser, aber eingereicht wird auch bei einem, das dort fehlt.
  bank             String?
  darlehenssumme   Float?
  sollzinsProzent  Float?
  zinsbindungJahre Int?
  /// Monatliche Rate ODER Tilgungssatz - der Vermittler hat je nach Bank das
  /// eine oder das andere vorliegen. Beide Felder sind optional; die Anzeige
  /// rechnet nichts um, was nicht dasteht.
  rateMonatlich    Float?
  tilgungProzent   Float?
  /// Ueber welche Plattform eingereicht wurde (europace, finlink, ehyp_home,
  /// direkt). Freitext, weil der Weg auch eine Bank-eigene Maske sein kann.
  plattform        String?
  /// "manuell" oder der Name der Plattform, aus der die Werte gezogen wurden.
  quelle           String    @default("manuell")
  eingereichtAm    DateTime?
  notiz            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kreditpruefungen")
}

model Liability {
  id             String   @id @default(cuid())
  caseId         String
  case           Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  art            String?
  glaeubiger     String?
  restschuld     Float?
  monatlicheRate Float?
  abzuloesen     Boolean  @default(false)
