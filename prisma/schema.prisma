  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  key               String
  category          String
  status            Severity
  explanation       String
  recommendedAction String?
  customerVisible   Boolean  @default(false)
  relevantEuropace  Boolean  @default(false)
  relevantFinlink   Boolean  @default(false)
  relevantEhyp      Boolean  @default(false)
  resolved          Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([caseId])
  @@map("plausibility_checks")
}

// ============================ WOHNFLAECHEN BERECHNUNG ============================

model WohnflaechenBerechnung {
  id               String   @id @default(cuid())
  caseId           String
  case             Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  // Geprüfte Raumliste (WoflvRoomResult[]) als JSON – editierbar, nachvollziehbar.
  rooms            Json
  summeWohnflaeche Float    @default(0)
  summeZubehoer    Float    @default(0)
  released         Boolean  @default(false)
  model            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([caseId])
  @@map("wohnflaechen_berechnungen")
}

// ============================ SELBSTAUSKUNFT ============================

/**
 * Öffentliches Anfrageformular einer Organisation: ein Dauerlink, der Bögen
 * ERZEUGT statt selbst einer zu sein. Nur so kann ein Link von mehreren
 * benutzt werden, ohne dass der zweite Interessent die Antworten des ersten
 * sieht – jeder bekommt beim ersten abgesendeten Schritt sein eigenes Token.
 */
model Leadformular {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Wem die Fälle aus diesem Formular gehören.
  brokerId       String
  /// Teil der öffentlichen URL: /anfrage/<slug>
  slug           String       @unique
  aktiv          Boolean      @default(true)
  createdAt      DateTime     @default(now())

  links SelfDisclosureLink[]

  @@index([organizationId])
  @@map("leadformulare")
}

/**
 * Magic Link für die Selbstauskunft – bewusst getrennt vom Upload-Link, damit
 * ein Token nie versehentlich für den jeweils anderen Weg gilt.
 */
model SelfDisclosureLink {
  id         String        @id @default(cuid())
  /// Gesetzt beim persönlichen Link aus einer Fallakte. Null beim
  /// Formular-Link: dort entsteht der Fall erst beim Absenden.
  caseId     String?
  case       Case?         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// Gesetzt beim Formular-Link. Genau eines von caseId/formularId ist gesetzt.
  formularId String?
  formular   Leadformular? @relation(fields: [formularId], references: [id], onDelete: Cascade)
  tokenHash  String        @unique
  expiresAt  DateTime
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())

  disclosure SelfDisclosure?

  @@index([caseId])
  @@index([formularId])
  @@map("self_disclosure_links")
}

/**
 * Ein Durchgang des Bogens. Hängt am Link, nicht am Fall: Ein zweiter Bogen
 * erzeugt einen neuen Durchgang, der erste bleibt als belegter Stand erhalten.
 */
model SelfDisclosure {
  id                  String             @id @default(cuid())
  linkId              String             @unique
  link                SelfDisclosureLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  /// Null, solange der Bogen aus einem Anfrageformular stammt und noch
  /// niemand abgesendet hat. Beim Absenden entsteht der Fall und wird
  /// nachgetragen.
  caseId              String?
  case                Case?              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  answers             Json               @default("{}")
  currentStep         String?
  submittedAt         DateTime?
  takenOverAt         DateTime?
  /// Datenschutz-Einwilligung des Formular-Wegs. Ohne Zeitpunkt und Fassung
  /// ist eine Einwilligung nicht nachweisbar.
  einwilligungAm      DateTime?
  einwilligungFassung String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([caseId])
  @@map("self_disclosures")
}

// ============================ LEAD-EINGANG ============================

/**
 * Wasserstandsmarke und Zustand des Lead-Abgleichs, je Organisation und Quelle.
 * Eigenes Modell statt PlatformConnection: Dort gibt es keinen Platz für
 * Zeitstempel und Fehler, und die Tabelle wird heute nur gelesen.
 */
model LeadSyncState {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Heute nur "finlink"; der Mail-Weg bekommt später einen eigenen Eintrag.
   */
  quelle         String
  /**
   * Eingangszeitpunkt des zuletzt verarbeiteten Leads.
   */
  syncedUntil    DateTime?
  lastRunAt      DateTime?
  lastCreated    Int          @default(0)
  lastError      String?
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, quelle])
  @@map("lead_sync_states")
}

// ============================ REGISTRIERUNG / ZUGANG ============================

/**
 * Ein Registrierungsantrag. Organisation und Nutzer entstehen bewusst ERST bei
 * der Freigabe – so enthaelt `organizations` ausschliesslich echte Kunden und
 * keine abgebrochenen Anmeldungen, die jede Auswertung verfaelschen wuerden.
 */
model SignupRequest {
  id           String       @id @default(cuid())
  email        String       @unique
  // Nur bis zur Freigabe belegt: dort wandert der Hash an den neuen User und
  // wird hier auf null gesetzt. Sonst laege er doppelt vor, und die Kopie am
  // Antrag ueberlebte jeden spaeteren Passwortwechsel des Nutzers.
  passwordHash String?
  name         String
  firmenname   String
  telefon      String?
  wunschtarif  PlanTier?
  status       SignupStatus @default(neu)

  emailBestaetigtAm DateTime?

  agbVersion      String
  agbAkzeptiertAm DateTime
  agbIp           String?

  entschiedenAm   DateTime?
  entschiedenVon  String?
  ablehnungsgrund String?

  // Gesetzt bei der Freigabe – die Spur vom Antrag zum Kunden.
  organizationId String?   @unique
  // Instanzunabhaengige Sperre gegen Mailfluten (In-Memory-Limit greift auf
  // Vercel nur pro Instanz).
  letzteMailAm   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokens AuthToken[]

  @@index([status])
  @@map("signup_requests")
}

/**
 * Magic Link fuer Zugangszwecke. Anders als bei UploadLink/SelfDisclosureLink
 * steckt die Trennung im Feld `zweck`, nicht in der Tabelle – sie ist deshalb
 * nur so verlaesslich, wie jede Pruefung den Zweck mitfiltert. Genau dafuer gibt
 * es exakt eine Einloesefunktion: verbraucheToken(token, zweck).
 */
model AuthToken {
  id              String         @id @default(cuid())
  tokenHash       String         @unique
  zweck           AuthTokenZweck
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  signupRequestId String?
  signupRequest   SignupRequest? @relation(fields: [signupRequestId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime       @default(now())

  @@index([userId])
  @@index([signupRequestId])
  @@index([expiresAt])
  @@map("auth_tokens")
}

/**
 * Ein von der KI im Dokument gefundener Verweis auf eine andere Urkunde.
 * Reine Faktenebene ohne Bewertung. kind = "selbst" ist die Eigenauskunft des
 * Dokuments ("Ich bin der 2. Nachtrag, UR 789/2011") und die Voraussetzung
 * dafuer, dass der Abgleich ueberhaupt einen Treffer finden kann.
 */
model DocumentReference {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  kind           String
  label          String
  urkundeDatum   DateTime?
  urkundenNummer String?
  notar          String?
  abteilung      String?
  laufendeNummer String?
  sourcePage     Int
  sourceQuote    String
  confidence     Float?

  createdAt DateTime @default(now())

  findings CaseFinding[]

  @@index([documentId])
  @@index([caseId])
  @@map("document_references")
}

/**
 * Ein aus Verweisen und Regeln abgeleiteter Befund. Traegt Zustand, weil die
 * Freigabe- und Verwerf-Entscheidungen des Vermittlers einen erneuten Lauf
 * ueberleben muessen; der fingerprint sichert das ueber den Unique-Index ab.
 */
model CaseFinding {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  code       String
  title      String
  reason     String
  severity   Severity @default(warnung)
  /// neue_position | dokument_nachfordern
  resolution String

  suggestedDocumentType DocumentType?

  sourceDocumentId String
  sourceDocument   Document @relation("FindingSource", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  sourcePage       Int?
  sourceQuote      String?

  referenceId String?
  reference   DocumentReference? @relation(fields: [referenceId], references: [id], onDelete: SetNull)

  /// Bei unsicherem Abgleich: das vermutete, bereits vorhandene Dokument.
  matchCandidateId String?

  /// offen | unsicher | freigegeben | verworfen | erledigt
  status String @default("offen")

  checklistItemId String?

  fingerprint String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, fingerprint])
  @@index([caseId, status])
  @@map("case_findings")
}

/**
 * Marktannahmen des Vermittlers fuer den Machbarkeits-Solver. Bewusst je
 * Organisation: Zinsaufschlaege sind Marktkenntnis und aendern sich laufend.
 * Fehlt der Datensatz, gelten die Vorgabewerte aus VORGABE_ANNAHMEN – die
 * Mitte dokumentierter Marktspannen, keine Bankkonditionen.
 */
model MachbarkeitsAnnahmen {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  basiszinsProzent Float @default(3.5)
  aufschlagBis80   Float @default(0.1)
  aufschlagBis90   Float @default(0.3)
  aufschlagBis100  Float @default(0.6)
  aufschlagBis110  Float @default(1.2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("machbarkeits_annahmen")
}

/**
 * Vorgeschlagene Aufteilung einer Sammeldatei. Lebt nur, bis der Vermittler
 * auftrennt oder verwirft – ausgefuehrt wird sie zu echten Dokumenten.
 */
model DocumentSplitSegment {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  reihenfolge   Int
  vonSeite      Int
  bisSeite      Int
  vermuteterTyp DocumentType?
  titel         String
  confidence    Float?

  createdAt DateTime @default(now())

  @@index([documentId])
  @@map("document_split_segments")
}

/**
 * Vorschlag, mehrere Einzelseiten eines Falls zu einem Dokument zu verbinden.
 * Lebt nur bis zur Entscheidung: zusammengefuegt oder verworfen.
 */
model DocumentBuendel {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  reihenfolge   Int
  titel         String
  vermuteterTyp DocumentType?
  confidence    Float?

  createdAt DateTime               @default(now())
  seiten    DocumentBuendelSeite[]

  @@index([caseId])
  @@map("document_buendel")
}

/**
 * Eine Seite in einem Buendelvorschlag. `position` ist die Reihenfolge im
 * spaeteren PDF - nicht die Uploadreihenfolge.
 */
model DocumentBuendelSeite {
  id         String          @id @default(cuid())
  buendelId  String
  buendel    DocumentBuendel @relation(fields: [buendelId], references: [id], onDelete: Cascade)
  documentId String
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)

  position Int

  @@unique([buendelId, documentId])
  @@index([documentId])
  @@map("document_buendel_seiten")
}

/**
 * Kreditinstitut aus dem Europace-Kriteriencheck. Bewusst OHNE organizationId:
 * die Kriterien sind fuer alle gleich – Referenzwissen, keine Mandantendaten.
 */
model Bank {
  id               String   @id @default(cuid())
  /// Europace-Kennung, z. B. "SPK_DIREKT". NICHT mit der Relation bankRefId verwechseln.
  bankId           String   @unique
  name             String
  zuletztGesehenAm DateTime

  kriterien       BankKriterium[]
  produktMerkmale BankProduktMerkmal[]

  @@index([name])
  @@map("banken")
}

/**
 * Ein Finanzierungskriterium einer Bank.
 * `standAm` ist das Datum, das EUROPACE fuer diese Zeile nennt.
 * `importiertAm` ist unser Abrufdatum. Die beiden nie verwechseln: Wir koennen
 * heute geholt haben, waehrend die Bank sich zuletzt im Februar geaeussert hat.
 */
model BankKriterium {
  id        String @id @default(cuid())
  bankRefId String
  bank      Bank   @relation(fields: [bankRefId], references: [id], onDelete: Cascade)

  kriterium String
  kategorie String
  /// MACHBAR | VORBEHALTLICH | NICHT_MACHBAR | INFORMATION | KEINE_ANGABE
  /// Bewusst Text statt Enum – ein neuer Wert darf den Import nicht kippen.
  status    String
  /// Bereits bereinigtes HTML (siehe src/lib/banken/bereinigen.ts).
  inhalt    String

  standAm      DateTime?
  importiertAm DateTime

  @@unique([bankRefId, kriterium])
  @@index([kriterium, status])
  @@map("bank_kriterien")
}

/// Eine Zeile aus der Produktuebersicht des Europace-Wikis.
///
/// BEWUSST eine eigene Tabelle und keine Erweiterung von BankKriterium: Die
/// Zeilen haben eine andere Gestalt (kein Status, kein Stand je Zeile, eigene
/// Gliederung), und die Namen ueberschneiden sich – "Grenzgaenger" steht in
/// beiden Tabellen mit verschiedenem Inhalt.
///
/// Nur 28 der 685 Wiki-Artikel fuehren diese Tabelle, dafuer die
/// ueberregionalen Anbieter. Quelle und Zuordnung:
/// docs/superpowers/specs/2026-08-11-produktuebersicht-design.md
model BankProduktMerkmal {
  id        String @id @default(cuid())
  bankRefId String
  bank      Bank   @relation(fields: [bankRefId], references: [id], onDelete: Cascade)

  /// Antragsteller | Immobilie | Finanzierungsloesung | Prolongation | Hinweise zum Prozess | ...
  abschnitt      String
  /// Feinere Gliederung, z. B. "Allgemein", "KfW", "Legitimation". Oft leer –
  /// dann leerer Text und NICHT null: Postgres zaehlt NULL im eindeutigen Index
  /// als jeweils verschieden, ein zweiter Import wuerde Dubletten anlegen.
  unterabschnitt String @default("")
  bezeichnung    String
  /// Reiner Text, kein HTML. "keine Angabe" ist ein haeufiger, echter Wert –
  /// er darf NIE als Ablehnung gelesen werden.
  wert           String

  /// Zendesk-Artikel, aus dem die Zeile stammt.
  artikelId    String
  /// Wann Europace den Artikel zuletzt geaendert hat.
  standAm      DateTime?
  importiertAm DateTime

  @@unique([bankRefId, abschnitt, unterabschnitt, bezeichnung])
  @@index([bezeichnung])
  @@map("bank_produkt_merkmale")
}

/// Ein Abruf der Unterlagenanforderungen fuer GENAU EINE Bank.
/// Bankwechsel ist deshalb eine Frage von `aktiv`, keine Loeschung: Was fuer
/// Bank A geholt wurde, bleibt als Verlauf liegen.
model BankAnforderungsAbruf {
  id             String            @id @default(cuid())
  caseId         String
  case           Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// Europace-Produktanbieter-Id (z. B. ING_DIBA), wenn ermittelbar.
  bankId         String?
  bankName       String
  /// "antrag" (verbindlich) | "vorschlag" (vor der Einreichung)
  quelle         String
  vorgangsNummer String
  /// antragsNummer oder finanzierungsvorschlagsId
  bezugsId       String
  abgerufenAm    DateTime
  aktiv          Boolean           @default(true)
  anforderungen  BankAnforderung[]

  @@unique([caseId, quelle, bezugsId])
  @@index([caseId, aktiv])
  @@map("bank_anforderungs_abrufe")
}

model BankAnforderung {
  id                    String                @id @default(cuid())
  abrufId               String
  abruf                 BankAnforderungsAbruf @relation(fields: [abrufId], references: [id], onDelete: Cascade)
  /// Unterlagenanforderung.id aus Europace
  externeId             String
  code                  String
  text                  String
  kurzbezeichnung       String
  erfuellungskategorien String[]              @default([])
  bezugTyp              String?
  bezugName             String?
  bezugRolle            String?
  liegtVor              Boolean               @default(false)
  ausgeblendet          Boolean               @default(false)
  /// Beim Abruf aufgeloest und abgelegt, nicht bei jeder Anzeige neu gerechnet.
  documentType          DocumentType?
  applicantId           String?

  @@unique([abrufId, externeId])
  @@map("bank_anforderungen")
}

// ============================ BACKOFFICE ============================

/**
 * Ein Auftraggeber des Backoffice: der Vermittler oder das Vermittlungs-
 * unternehmen, das Aufbereitung beauftragt. Gehoert dem Backoffice-Partner
 * (`backofficeOrganizationId`) - das ist der Mandant, der ihn sieht.
 * `organizationId` verknuepft optional eine BaufiDesk-Organisation, deren
 * Nutzer dann das Auftraggeberportal fuer GENAU diese Auftraege sehen.
 * Der Antragsteller (Endkunde) steht NIE hier, sondern an der Akte.
 */
model BackofficeAuftraggeber {
  id                       String        @id @default(cuid())
  backofficeOrganizationId String
  backofficeOrganization   Organization  @relation("BackofficeMandant", fields: [backofficeOrganizationId], references: [id], onDelete: Cascade)
  organizationId           String?
  organization             Organization? @relation("AuftraggeberOrganisation", fields: [organizationId], references: [id], onDelete: SetNull)

  name                        String
  kurzname                    String?
  street                      String?
  zip                         String?
  city                        String?
  email                       String?
  phone                       String?
  abrechnungsmodell           BackofficeAbrechnungsmodell @default(testfall)
  /// Enthaltene Faelle je Monat beim Abo. null = kein Kontingent (Einzelpreis).
  kontingentMonatlich         Int?
  /// Wie viele ungenutzte Faelle in den Folgemonat mitgenommen werden duerfen.
  carryOverMax                Int                         @default(0)
  /// Vereinbarte Frist in Werktagen; null = Vorgabe der Organisation.
  slaTage                     Int?
  /// Darf das Backoffice den Antragsteller direkt ansprechen (Upload-Link,
  /// Nachforderung)? Voreinstellung nein: der Auftraggeber bleibt Herr des
  /// Kundenkontakts.
  antragstellerKontaktErlaubt Boolean                     @default(false)
  aktiv                       Boolean                     @default(true)
  notizIntern                 String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  kontakte             BackofficeAuftraggeberKontakt[]
  auftraege            BackofficeAuftrag[]
  kontingentEreignisse BackofficeKontingentEreignis[]

  @@unique([backofficeOrganizationId, organizationId])
  @@index([backofficeOrganizationId])
  @@index([organizationId])
  @@map("backoffice_auftraggeber")
}

/// Ansprechperson beim Auftraggeber. `userId` bindet sie an einen Portal-
/// Nutzer der verknuepften Organisation.
model BackofficeAuftraggeberKontakt {
  id                     String                 @id @default(cuid())
  auftraggeberId         String
  auftraggeber           BackofficeAuftraggeber @relation(fields: [auftraggeberId], references: [id], onDelete: Cascade)
  name                   String
  email                  String?
  phone                  String?
  userId                 String?
  user                   User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Sieht im Portal alle Auftraege des Auftraggebers, nicht nur die eigenen.
  darfAlleAuftraegeSehen Boolean                @default(true)
  aktiv                  Boolean                @default(true)
  createdAt              DateTime               @default(now())

  auftraege BackofficeAuftrag[]

  @@index([auftraggeberId])
  @@index([userId])
  @@map("backoffice_auftraggeber_kontakte")
}

/**
 * Ein Backoffice-Auftrag. Eigenes Hauptobjekt neben dem Fall: Der Fall ist
 * die Finanzierungsakte (Antragsteller, Objekt, Dokumente), der Auftrag ist
 * die Arbeit daran im Auftrag eines Dritten - mit eigenem Status, eigener
 * Frist, eigenem Bearbeiter. Kein Statuswechsel hier beruehrt Case.status
 * oder Case.leadPhase.
 */
model BackofficeAuftrag {
  id                       String                         @id @default(cuid())
  backofficeOrganizationId String
  backofficeOrganization   Organization                   @relation(fields: [backofficeOrganizationId], references: [id], onDelete: Cascade)
  auftragsnummer           String
  auftraggeberId           String
  auftraggeber             BackofficeAuftraggeber         @relation(fields: [auftraggeberId], references: [id], onDelete: Restrict)
  kontaktId                String?
  kontakt                  BackofficeAuftraggeberKontakt? @relation(fields: [kontaktId], references: [id], onDelete: SetNull)
  caseId                   String
  case                     Case                           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /// Anzeigename der Akte, meist der Antragsteller. Steht hier, damit die
  /// Queue ohne Join auf die Antragsteller lesbar bleibt.
  aktenbezeichnung String
  /// Schluessel aus AUFTRAGSARTEN (src/lib/backoffice/leistungen.ts). Text
  /// statt Enum, damit eine neue Auftragsart keine Migration erzwingt.
  auftragsart      String
  /// Schluessel aus LEISTUNGSBAUSTEINE.
  leistungen       String[]             @default([])
  prioritaet       BackofficePrioritaet @default(normal)
  eingangAm        DateTime             @default(now())
  faelligAm        DateTime?
  /// manuell | portal | vertrieb_uebergabe
  quelle           String               @default("manuell")
  /// Externe Referenz des Auftraggebers (eigene Vorgangsnummer, Plattform-ID).
  referenzExtern   String?

  status        BackofficeStatus @default(neu_eingegangen)
  statusSeit    DateTime         @default(now())
  wartegrund    String?
  pausiertSeit  DateTime?
  pausiertGrund String?

  bearbeiterId  String?
  bearbeiter    User?   @relation("BackofficeBearbeiter", fields: [bearbeiterId], references: [id], onDelete: SetNull)
  prueferId     String?
  pruefer       User?   @relation("BackofficePruefer", fields: [prueferId], references: [id], onDelete: SetNull)
  erstelltVonId String?
  erstelltVon   User?   @relation("BackofficeErsteller", fields: [erstelltVonId], references: [id], onDelete: SetNull)

  /// Hinweise des Auftraggebers - fuer beide Seiten sichtbar.
  hinweiseAuftraggeber String?
  /// Interne Notizen des Backoffice - NIE im Portal.
  interneNotizen       String?
  /// Beschreibung des Lieferumfangs; im Portal sichtbar ab Uebergabe.
  ergebnisText         String?

  qualitaetFreigegebenAm    DateTime?
  qualitaetFreigegebenVonId String?
  qualitaetBegruendung      String?
  uebergebenAm              DateTime?
  abgenommenAm              DateTime?
  abnahmeKommentar          String?
  abrechnungsstatus         BackofficeAbrechnungsstatus @default(offen)
  feedbackBewertung         Int?
  feedbackText              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ereignisse           BackofficeAuftragEreignis[]
  rueckfragen          BackofficeRueckfrage[]
  kontingentEreignisse BackofficeKontingentEreignis[]

  @@unique([backofficeOrganizationId, auftragsnummer])
  @@index([backofficeOrganizationId, status])
  @@index([auftraggeberId])
  @@index([caseId])
  @@index([bearbeiterId])
  @@index([faelligAm])
  @@map("backoffice_auftraege")
}

/// Verlauf eines Auftrags: jeder Statuswechsel, jede Zuweisung, jede
/// Freigabe. Ergaenzt das AuditLog um die fachliche Lesbarkeit; das Portal
/// zeigt nur Eintraege mit `sichtbarFuerAuftraggeber`.
model BackofficeAuftragEreignis {
  id                       String            @id @default(cuid())
  auftragId                String
  auftrag                  BackofficeAuftrag @relation(fields: [auftragId], references: [id], onDelete: Cascade)
  /// status_wechsel | zuweisung | pause | qc_freigabe | qc_rueckgabe |
  /// uebergabe | abnahme | rueckfrage | notiz | nachbearbeitung_angefordert
  art                      String
  vonStatus                BackofficeStatus?
  nachStatus               BackofficeStatus?
  text                     String?
  sichtbarFuerAuftraggeber Boolean           @default(false)
  userId                   String?
  user                     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt                DateTime          @default(now())

  @@index([auftragId, createdAt])
  @@map("backoffice_auftrag_ereignisse")
}

/// Rueckfrage des Backoffice an den Auftraggeber. Entsteht als Entwurf und
/// wird erst nach bewusster Freigabe (Vorschau + Bestaetigung) im Portal
/// sichtbar. Es wird nichts automatisch versendet.
model BackofficeRueckfrage {
  id               String                     @id @default(cuid())
  auftragId        String
  auftrag          BackofficeAuftrag          @relation(fields: [auftragId], references: [id], onDelete: Cascade)
  betreff          String
  frage            String
  antwort          String?
  status           BackofficeRueckfrageStatus @default(entwurf)
  gestelltVonId    String?
  gestelltAm       DateTime?
  beantwortetVonId String?
  beantwortetAm    DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([auftragId, status])
  @@map("backoffice_rueckfragen")
}

/// Ein Kontingent-Ereignis: Verbrauch (bei Uebergabe), Zusatzfall oder
/// Korrektur durch einen Manager. `menge` ist das Vorzeichen: +1 verbraucht,
/// -1 gibt zurueck. Der Idempotenzschluessel verhindert Doppelzaehlung, wenn
/// eine Uebergabe zweimal ausgeloest wird.
model BackofficeKontingentEreignis {
  id                   String                  @id @default(cuid())
  auftraggeberId       String
  auftraggeber         BackofficeAuftraggeber  @relation(fields: [auftraggeberId], references: [id], onDelete: Cascade)
  auftragId            String?
  auftrag              BackofficeAuftrag?      @relation(fields: [auftragId], references: [id], onDelete: SetNull)
  art                  BackofficeKontingentArt
  menge                Int
  /// Abrechnungsperiode "JJJJ-MM".
  periode              String
  begruendung          String?
  idempotenzSchluessel String                  @unique
  userId               String?
  createdAt            DateTime                @default(now())

  @@index([auftraggeberId, periode])
  @@map("backoffice_kontingent_ereignisse")
}
