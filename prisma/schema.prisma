model EmploymentRecord {
  id                 String          @id @default(cuid())
  applicantId        String
  applicant          Applicant       @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  beschaeftigungsart EmploymentType?
  beruf              String?
  arbeitgeber        String?
  arbeitgeberAdresse String?
  eintrittsdatum     DateTime?
  befristetBis       DateTime?
  // Ja/Nein-Antwort des Erstgespraechs (siehe reife.ts): befristetBis bleibt
  // als Datum bestehen (Anzeige + FinLink-Import), ist aber keine Frage mehr,
  // weil sie fuer die Mehrheit der Faelle (unbefristet, selbstaendig) nie
  // ausfuellbar ist. Vorbelegung false = "nein" ist bereits eine Antwort.
  befristet          Boolean         @default(false)
  inProbezeit        Boolean         @default(false)
  createdAt          DateTime        @default(now())

  @@index([applicantId])
  @@map("employment_records")
}

model SelfEmploymentRecord {
  id                 String    @id @default(cuid())
  applicantId        String    @unique
  applicant          Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  firma              String?
