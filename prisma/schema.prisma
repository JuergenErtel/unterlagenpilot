// ============================ DOKUMENTE ============================

model Document {
  id          String     @id @default(cuid())
  caseId      String
  case        Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  applicantId String?
  applicant   Applicant? @relation(fields: [applicantId], references: [id], onDelete: SetNull)

  originalName  String
  // Automatisch generierter sinnvoller Dateiname
  generatedName String?
  storageKey    String // Pfad/Key im Storage (S3/Supabase/local)
  mimeType      String
  sizeBytes     Int
  pageCount     Int?

  documentType         DocumentType?
  uploadSource         UploadSource
  // Sicherheits-/Scan-Status. OCR/KI laufen erst nach virus_scan_clean/ready_for_ocr.
  scanStatus           DocumentScanStatus   @default(virus_scan_pending)
  scanEngine           String?
  scannedAt            DateTime?
  ocrStatus            ProcessingStatus     @default(ausstehend)
  classificationStatus ProcessingStatus     @default(ausstehend)
  extractionStatus     ProcessingStatus     @default(ausstehend)
  // Lauf des Unterlagen-Detektivs. Eigener Status, damit "nicht geprueft" und
  // "nichts gefunden" im UI unterscheidbar bleiben.
  referenceStatus      ProcessingStatus     @default(ausstehend)
  // Erkennung, ob die Datei mehrere Dokumente enthaelt. Eigener Status, damit
  // "nicht geprueft" und "nichts gefunden" unterscheidbar bleiben.
  splitStatus          ProcessingStatus     @default(ausstehend)
  reviewStatus         DocumentReviewStatus @default(offen)
  // Grund einer Ablehnung. Wird dem Kunden auf der Upload-Seite angezeigt –
  // deshalb kundentauglich formulieren, keine internen Kuerzel.
  reviewNote           String?
  confidence           Float?

  detectedApplicant  String?
  /// Von Europace vergebene Dokument-ID. Gesetzt = bereits uebertragen.
  europaceDokumentId String?
  /// Herkunft der Antragsteller-Zuordnung: "auto" (Namensabgleich) oder
  /// "manuell" (Vermittler). null = Bestandsdaten unbekannter Herkunft; diese
  /// werden wie "manuell" behandelt, solange sie eine Zuordnung tragen.
  applicantSource    String?
  propertyRef        String?
  period             String? // Zeitraum, z.B. 2026-05
  issuer             String? // Aussteller

  // Qualitaet / Duplikat
  readable      Boolean?
  missingPages  Boolean?
  isDuplicate   Boolean  @default(false)
  duplicateOfId String?

  // Plattform- / Bankzuordnung
  platformRelevance  Platform[]
  bankRequirementKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages            DocumentPage[]
  classifications  DocumentClassification[]
  extractedFields  ExtractedFieldRecord[]
  warnings         DocumentWarning[]
  duplicateChecksA DuplicateCheck[]         @relation("DupA")
  duplicateChecksB DuplicateCheck[]         @relation("DupB")
  checklistLinks   CaseChecklistItem[]      @relation("ChecklistDocuments")
  ocrJobs          OcrJob[]
  aiJobs           AiJob[]
  references       DocumentReference[]
  findings         CaseFinding[]            @relation("FindingSource")
  splitSegmente    DocumentSplitSegment[]

  /// Herkunftsdatei, falls dieses Dokument aus einer Aufteilung entstand.
  aufgeteiltAusId String?
  aufgeteiltAus   Document?  @relation("Aufteilung", fields: [aufgeteiltAusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teildokumente   Document[] @relation("Aufteilung")

  /// Zieldokument, falls diese Seite in ein Buendel eingegangen ist. Spiegel
  /// zu aufgeteiltAusId: dort wurde eine Datei zu vielen, hier werden viele zu
  /// einer.
  zusammengefuegtInId String?
  zusammengefuegtIn   Document?              @relation("Buendelung", fields: [zusammengefuegtInId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quellseiten         Document[]             @relation("Buendelung")
  buendelSeiten       DocumentBuendelSeite[]

  @@index([caseId])
  @@index([documentType])
  @@map("documents")
}

model DocumentPage {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber Int
  ocrText    String? // OCR-Text; kann sensible Daten enthalten -> verschluesselt at-rest empfohlen
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@map("document_pages")
}

model DocumentClassification {
  id           String       @id @default(cuid())
  documentId   String
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentType DocumentType
  confidence   Float
  reasoning    String?
  model        String? // verwendetes KI-Modell (zur Nachvollziehbarkeit)
  createdAt    DateTime     @default(now())

  @@index([documentId])
  @@map("document_classifications")
}

model ExtractedFieldRecord {
  id             String   @id @default(cuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  key            String
  label          String
